rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins: dedicated email+password accounts only (a phone or Google login
    // can never match). Keep in sync with ADMIN_EMAILS in functions/access.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['control@lineuptech.admin'];
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User profile doc. Owners may edit their own data but NOT the
    // admin-controlled fields (account status, plan, admin notes).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['status', 'plan', 'adminNote']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'plan', 'adminNote']);
      allow delete: if false;

      // Bots, leads, notifications, conversations, autoReplies...
      match /{document=**} {
        allow read, write: if isOwner(uid);
        allow read: if isAdmin();
      }
    }

    // Plans are readable by any signed-in user; changed only via admin functions.
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Payments and audit logs: admin read-only; written only by Cloud Functions.
    match /payments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /systemEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
